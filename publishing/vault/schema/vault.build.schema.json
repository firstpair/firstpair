{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstpair.org/schemas/vault.build.schema.json",
  "title": "FirstPair vault build",
  "type": "object",
  "required": [
    "schemaVersion",
    "slug",
    "title",
    "profile",
    "sourceCommit",
    "reader",
    "products"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "repoRoot": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "code",
        "history",
        "triptych"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "description": "Use HEAD for a title-owned committed contract, or an exact 40-character commit for an externally pinned source.",
      "pattern": "^(HEAD|[0-9a-f]{40})$"
    },
    "plugin": {
      "type": "boolean"
    },
    "nativeDriver": {
      "type": "object",
      "description": "Thin title-owned producer and validator used when an existing vault has richer semantics than the canonical projection model.",
      "required": [
        "build",
        "validate"
      ],
      "properties": {
        "build": {
          "$ref": "#/$defs/command"
        },
        "validate": {
          "$ref": "#/$defs/command"
        }
      },
      "additionalProperties": false
    },
    "guide": {
      "type": "object",
      "properties": {
        "bookSpecific": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reader": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "preview": {
            "type": "boolean"
          },
          "part": {
            "type": "string",
            "description": "Emacs part grouping; names one of emacs.parts[].title. Consecutive pages with the same part form one part node."
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "rights": {
            "enum": [
              "redistributable",
              "metadata-only",
              "restricted"
            ]
          },
          "referencedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rights": {
            "enum": [
              "redistributable",
              "metadata-only",
              "restricted"
            ]
          },
          "referencedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "products": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "desktop": {
          "$ref": "#/$defs/product"
        },
        "mobile": {
          "$ref": "#/$defs/product"
        },
        "preview": {
          "$ref": "#/$defs/product"
        }
      },
      "additionalProperties": false
    },
    "emacs": {
      "type": "object",
      "description": "Emacs Info bundle delivery, read by firstpair-emacs beside the shared core.",
      "required": [
        "products"
      ],
      "properties": {
        "aligned": {
          "type": "object",
          "description": "The aligned edition's reader index (firstpair-parallel-reader-v1): languages and the translations of each, rendered as regions the reader rotates through.",
          "properties": {
            "index": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "guide": {
          "type": "object",
          "description": "Book-specific guide fragment for the Emacs bundle; defaults to the shared guide.bookSpecific.",
          "properties": {
            "bookSpecific": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "direntry": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Info manual stem; defaults to the slug."
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "subtitle": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "launcher": {
          "type": "string",
          "pattern": "^[^/]+\\.sh$",
          "description": "Executable launcher filename delivered with the Emacs bundle; defaults to firstpair.sh."
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "lexicon": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "latin",
                "italian"
              ]
            },
            "mode": {
              "enum": [
                "projected",
                "complete",
                "none"
              ]
            },
            "minimumLength": {
              "type": "integer",
              "minimum": 1
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "translations": {
              "type": "array",
              "minItems": 1,
              "description": "Target languages the dictionary window can show. Each may draw on a FirstPair-pinned glossary, a title dictionary in the shared firstpair-reader-dictionary-v1 schema, and a reviewed supplement.",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string"
                  },
                  "glossary": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ],
                    "description": "Identifier(s) of glossaries pinned in FirstPair's lexicon/<language>/SOURCES.json, consulted in order."
                  },
                  "dictionary": {
                    "type": "string",
                    "description": "Repository-relative firstpair-reader-dictionary-v1 JSON keyed by normalized form."
                  },
                  "supplement": {
                    "type": "string",
                    "description": "Repository-relative JSON of {form: [definitions]} reviewed by the title."
                  }
                },
                "additionalProperties": false
              }
            },
            "sourceId": {
              "type": "string",
              "description": "Identifier of the source language in aligned chapters (matches parallel-reader sourceLanguage.id)."
            },
            "supplement": {
              "type": "string",
              "description": "Repository-relative reviewed supplement for the analyser: forms the pinned corpus lacks, with headword, part of speech, definitions, and grammar."
            }
          },
          "additionalProperties": false
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "blocks"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "description": "Repository-relative JSON or JSON Lines file of records."
              },
              "kind": {
                "type": "string"
              },
              "identifier": {
                "type": "string",
                "description": "Field holding each record's unique id."
              },
              "label": {
                "type": "string",
                "description": "Template over record fields, e.g. \"{work_title} {citation}\"."
              },
              "rights": {
                "enum": [
                  "redistributable",
                  "metadata-only",
                  "restricted"
                ]
              },
              "section": {
                "type": "string"
              },
              "referencedBy": {
                "type": "string",
                "description": "Field listing the reader pages that quote the record."
              },
              "referenceMatch": {
                "enum": [
                  "source",
                  "id"
                ]
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Fields whose exact text receives a citation link in quoting pages."
              },
              "blocks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    },
                    "style": {
                      "enum": [
                        "paragraph",
                        "quotation",
                        "field",
                        "verbatim"
                      ]
                    },
                    "language": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "merge": {
                "type": "array",
                "description": "Further record files whose rows are merged into records with the same identifier, e.g. translations kept in a separate map.",
                "items": {
                  "type": "object",
                  "required": [
                    "source"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "identifier": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "products": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "desktop": {
              "$ref": "#/$defs/product"
            },
            "preview": {
              "$ref": "#/$defs/product"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product": {
      "type": "object",
      "required": [
        "output"
      ],
      "properties": {
        "output": {
          "type": "string"
        },
        "edition": {
          "enum": [
            "full",
            "preview"
          ]
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
